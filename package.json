{
  "name": "@local/dsh-modeldeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quick-apply saved provider + model + reasoning presets, with per-project fixed configurations and recent history.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/deck-core.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
